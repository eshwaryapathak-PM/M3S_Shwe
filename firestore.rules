rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── 0. GLOBAL SAFETY NET (DEFAULT DENY ALL) ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── HELPER FUNCTIONS ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the current user is the owner client
    function isOwner(clientId) {
      return isSignedIn() && request.auth.uid == clientId;
    }

    // Admin role check: either explicitly assigned in the admins collections/lists,
    // or bootstrapped from known administrative email accounts.
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/ppe_admins_list/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/prod_admins_list/$(request.auth.uid)) ||
        (request.auth.token != null && 'email' in request.auth.token && (
          request.auth.token.email.lower() == 'egpvai21@gmail.com' ||
          request.auth.token.email.lower() == 'shwetambari@mythirdspace.fit' ||
          request.auth.token.email.lower() == 'harshita@mythirdspace.fit'
        ))
      );
    }

    // Coach check: user has a record in the coaches or coaches_list collections
    function isCoach() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/coaches/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/coaches_list/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/ppe_coaches_list/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/prod_coaches_list/$(request.auth.uid)) ||
        (request.auth.token != null && 'email' in request.auth.token && (
          request.auth.token.email.lower().endsWith('@mythirdspace.fit') ||
          request.auth.token.email.lower() == 'egpvai21@gmail.com'
        ))
      );
    }

    // Check if current user is the coach assigned to this specific client's roster.
    // Looks up the client profile document in a safe, standard way.
    function isAssignedCoachOfClient(clientId, collectionName) {
      return isSignedIn() && isCoach() && 
        exists(/databases/$(database)/documents/$(collectionName)/$(clientId)) && (
          get(/databases/$(database)/documents/$(collectionName)/$(clientId)).data.assigned_coach_id == request.auth.uid ||
          (request.auth.token != null && 'email' in request.auth.token && 
           request.auth.token.email.split('@')[0] == get(/databases/$(database)/documents/$(collectionName)/$(clientId)).data.assigned_coach_id)
        );
    }

    // Highly optimized check when resource.data of the client profile is already available.
    // Extremely useful for list/query security rules to avoid O(n) recursive exists/get read lookups.
    function isAssignedCoachOfData(clientData) {
      return isSignedIn() && isCoach() && (
        clientData.assigned_coach_id == request.auth.uid ||
        (request.auth.token != null && 'email' in request.auth.token && 
         request.auth.token.email.split('@')[0] == clientData.assigned_coach_id)
      );
    }

    // ─── 1. CLIENT PROFILES ─────────────────────────────────────────────────
    match /clients/{clientId} {
      allow read, write: if isAdmin();
      allow read: if isOwner(clientId) || isAssignedCoachOfData(resource.data);
      allow create, update: if isOwner(clientId);
    }
    match /ppe_clients/{clientId} {
      allow read, write: if isAdmin();
      allow read: if isOwner(clientId) || isAssignedCoachOfData(resource.data);
      allow create, update: if isOwner(clientId);
    }
    match /prod_clients/{clientId} {
      allow read, write: if isAdmin();
      allow read: if isOwner(clientId) || isAssignedCoachOfData(resource.data);
      allow create, update: if isOwner(clientId);
    }

    // ─── 2. CLIENT ASSESSMENTS ──────────────────────────────────────────────
    match /assessments/{clientId} {
      allow read, write: if isAdmin();
      allow read: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'clients');
      allow create, update: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'clients');
    }
    match /ppe_assessments/{clientId} {
      allow read, write: if isAdmin();
      allow read: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'ppe_clients');
      allow create, update: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'ppe_clients');
    }
    match /prod_assessments/{clientId} {
      allow read, write: if isAdmin();
      allow read: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'prod_clients');
      allow create, update: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'prod_clients');
    }

    // ─── 3. SESSIONS & TIMETABLE ─────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && (resource.data.coach_id == request.auth.uid || resource.data.reassigned_coach_id == request.auth.uid)) ||
                  isAdmin();
      allow create: if isSignedIn() && (request.resource.data.client_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        request.resource.data.client_id == request.auth.uid || 
        resource.data.client_id == request.auth.uid ||
        (isCoach() && (resource.data.coach_id == request.auth.uid || resource.data.reassigned_coach_id == request.auth.uid)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    match /ppe_sessions/{sessionId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && (resource.data.coach_id == request.auth.uid || resource.data.reassigned_coach_id == request.auth.uid)) ||
                  isAdmin();
      allow create: if isSignedIn() && (request.resource.data.client_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        request.resource.data.client_id == request.auth.uid || 
        resource.data.client_id == request.auth.uid ||
        (isCoach() && (resource.data.coach_id == request.auth.uid || resource.data.reassigned_coach_id == request.auth.uid)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    match /prod_sessions/{sessionId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && (resource.data.coach_id == request.auth.uid || resource.data.reassigned_coach_id == request.auth.uid)) ||
                  isAdmin();
      allow create: if isSignedIn() && (request.resource.data.client_id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        request.resource.data.client_id == request.auth.uid || 
        resource.data.client_id == request.auth.uid ||
        (isCoach() && (resource.data.coach_id == request.auth.uid || resource.data.reassigned_coach_id == request.auth.uid)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── 4. BOOKING INVITES ──────────────────────────────────────────────────
    match /invites/{inviteId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create, update: if isSignedIn() && (
        request.resource.data.client_id == request.auth.uid || 
        (isCoach() && resource.data.coach_id == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    match /ppe_invites/{inviteId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create, update: if isSignedIn() && (
        request.resource.data.client_id == request.auth.uid || 
        (isCoach() && resource.data.coach_id == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    match /prod_invites/{inviteId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create, update: if isSignedIn() && (
        request.resource.data.client_id == request.auth.uid || 
        (isCoach() && resource.data.coach_id == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── 5. SESSION RATINGS & REVIEWS ────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.client_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data.client_id) || isAdmin();
    }
    match /ppe_ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.client_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data.client_id) || isAdmin();
    }
    match /prod_ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.client_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data.client_id) || isAdmin();
    }

    // ─── 6. SECURE CHAT LOGS ─────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create: if isSignedIn() && (
        (request.resource.data.client_id == request.auth.uid && request.resource.data.sender == 'client') ||
        (isCoach() && request.resource.data.coach_id == request.auth.uid && request.resource.data.sender == 'coach') ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }
    match /ppe_chats/{chatId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create: if isSignedIn() && (
        (request.resource.data.client_id == request.auth.uid && request.resource.data.sender == 'client') ||
        (isCoach() && request.resource.data.coach_id == request.auth.uid && request.resource.data.sender == 'coach') ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }
    match /prod_chats/{chatId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create: if isSignedIn() && (
        (request.resource.data.client_id == request.auth.uid && request.resource.data.sender == 'client') ||
        (isCoach() && request.resource.data.coach_id == request.auth.uid && request.resource.data.sender == 'coach') ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ─── 7. NUTRITION PLANS ──────────────────────────────────────────────────
    match /nutrition_plans/{clientId} {
      allow read: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'clients') || isAdmin();
      allow write: if isAssignedCoachOfClient(clientId, 'clients') || isAdmin();
    }
    match /ppe_nutrition_plans/{clientId} {
      allow read: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'ppe_clients') || isAdmin();
      allow write: if isAssignedCoachOfClient(clientId, 'ppe_clients') || isAdmin();
    }
    match /prod_nutrition_plans/{clientId} {
      allow read: if isOwner(clientId) || isAssignedCoachOfClient(clientId, 'prod_clients') || isAdmin();
      allow write: if isAssignedCoachOfClient(clientId, 'prod_clients') || isAdmin();
    }

    // ─── 8. COACH TECHNIQUE COMMENTS & SESSION NOTES ─────────────────────────
    match /session_notes/{noteId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create, update: if (isSignedIn() && isCoach()) || isAdmin();
      allow delete: if isAdmin();
    }
    match /ppe_session_notes/{noteId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create, update: if (isSignedIn() && isCoach()) || isAdmin();
      allow delete: if isAdmin();
    }
    match /prod_session_notes/{noteId} {
      allow read: if isOwner(resource.data.client_id) || 
                  (isSignedIn() && isCoach() && resource.data.coach_id == request.auth.uid) ||
                  isAdmin();
      allow create, update: if (isSignedIn() && isCoach()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── 9. BODY COMPOSITION ENTRIES (BCA) ───────────────────────────────────
    match /body_comp_entries/{entryId} {
      allow read: if isOwner(resource.data.client_id) || isAssignedCoachOfClient(resource.data.client_id, 'clients') || isAdmin();
      allow create, update: if isOwner(request.resource.data.client_id) || isAssignedCoachOfClient(request.resource.data.client_id, 'clients') || isAdmin();
      allow delete: if isAdmin();
    }
    match /ppe_body_comp_entries/{entryId} {
      allow read: if isOwner(resource.data.client_id) || isAssignedCoachOfClient(resource.data.client_id, 'ppe_clients') || isAdmin();
      allow create, update: if isOwner(request.resource.data.client_id) || isAssignedCoachOfClient(request.resource.data.client_id, 'ppe_clients') || isAdmin();
      allow delete: if isAdmin();
    }
    match /prod_body_comp_entries/{entryId} {
      allow read: if isOwner(resource.data.client_id) || isAssignedCoachOfClient(resource.data.client_id, 'prod_clients') || isAdmin();
      allow create, update: if isOwner(request.resource.data.client_id) || isAssignedCoachOfClient(request.resource.data.client_id, 'prod_clients') || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── 10. SCORE CARD OVERRIDES ────────────────────────────────────────────
    match /coach_overrides/{overrideId} {
      allow read: if isOwner(resource.data.client_id) || isCoach() || isAdmin();
      allow write: if isCoach() || isAdmin();
    }
    match /ppe_coach_overrides/{overrideId} {
      allow read: if isOwner(resource.data.client_id) || isCoach() || isAdmin();
      allow write: if isCoach() || isAdmin();
    }
    match /prod_coach_overrides/{overrideId} {
      allow read: if isOwner(resource.data.client_id) || isCoach() || isAdmin();
      allow write: if isCoach() || isAdmin();
    }

    // ─── 11. STAFF ROSTERS & LISTS (COACHES) ─────────────────────────────────
    match /coaches_list/{coachId} {
      allow read: if true;
      allow write: if true;
    }
    match /ppe_coaches_list/{coachId} {
      allow read: if true;
      allow write: if true;
    }
    match /prod_coaches_list/{coachId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── 12. ADMINISTRATORS & ROLES ──────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /ppe_admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /prod_admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /ppe_admins_list/{adminId} {
      allow read: if true;
      allow write: if true;
    }
    match /prod_admins_list/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── 13. GLOBAL METADATA / LOGS / APP-SETTINGS ───────────────────────────
    match /globals/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ppe_globals/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /prod_globals/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── 14. FINANCIAL TRANSACTIONS ──────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read, write: if isAdmin() || isCoach();
    }
    match /ppe_transactions/{transactionId} {
      allow read, write: if isAdmin() || isCoach();
    }
    match /prod_transactions/{transactionId} {
      allow read, write: if isAdmin() || isCoach();
    }
  }
}
